{
  "schemaVersion": 1,
  "profileName": "範例：光譜儀 + 單色儀 + 授權鎖",
  "vm": {
    "ramMB": 512,
    "image": "images/base.qcow2",
    "closeAction": "hibernate",
    "resumePolicy": "resume",
    "restorePoints": 3,
    "display": { "guestResolution": "1024x768", "scaling": "integer" }
  },
  "usb": [
    {
      "name": "光譜儀",
      "match": [{ "vid": "1234", "pid": "0001" }],
      "followReenumeration": [{ "vid": "1234", "pid": "0002" }],
      "autoAttach": true,
      "onResume": "replug",
      "returnToHost": true,
      "capture": false
    },
    {
      "name": "軟體授權鎖",
      "match": [{ "vid": "abcd", "pid": "0001" }],
      "autoAttach": true,
      "onResume": "keep",
      "returnToHost": false
    }
  ],
  "serial": [
    {
      "name": "單色儀",
      "host": { "usbSerialNumber": "FT1234AB" },
      "guestPort": "COM1"
    },
    {
      "name": "位移平台",
      "host": { "comPort": "COM3" },
      "guestPort": "COM2"
    }
  ],
  "launch": {
    "guestCommand": "C:\\Program Files\\OpticalApp\\OpticalApp.exe",
    "kiosk": true
  },
  "dataSync": {
    "guestPath": "C:\\Data",
    "hostPath": "%USERPROFILE%\\Documents\\XPOptical\\Data",
    "direction": "guest-to-host"
  },
  "network": "isolated"
}
