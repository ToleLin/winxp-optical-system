<Window x:Class="XPOptical.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" FontFamily="{StaticResource UiFont}" FontSize="14" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <GroupBox Header="關閉視窗時" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <RadioButton x:Name="HibernateRadio" Margin="0,4" GroupName="Close"
                             Content="快速休眠（建議）：下次開啟回到原本的畫面，光學軟體不用重開" />
                <RadioButton x:Name="ShutdownRadio" Margin="0,4" GroupName="Close"
                             Content="正常關機：XP 關機，下次重新開機" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="iHR320 是哪一個 USB 裝置？" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"
                           Text="選擇後，只要插上 iHR320 的 USB 線並開啟電源，就會自動連到 XP。" />
                <ListBox x:Name="DeviceList" Height="170" />
                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="重新整理" Padding="12,4" Click="OnRefreshClick" />
                    <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="12" VerticalAlignment="Center"
                               Text="不確定是哪一個？先拔掉 iHR320 的 USB 線按「重新整理」，再插上按一次，新出現的就是 iHR320。" />
                </DockPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="其他要連到 XP 的 USB 裝置（例如用來複製量測資料的隨身碟）" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <ListBox x:Name="OtherDeviceList" Height="110">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Text}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock TextWrapping="Wrap" Foreground="#777" FontSize="12" Margin="0,6,0,0"
                           Text="勾選的裝置連到 XP 時，Windows 這邊會暫時看不到它。複製完成後先在 XP 裡「安全地移除硬體」，再回到這裡取消勾選，裝置就會回到 Windows。" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="XP 記憶體" Padding="10" Margin="0,0,0,16">
            <StackPanel>
                <ComboBox x:Name="RamCombo" Width="200" HorizontalAlignment="Left">
                    <ComboBoxItem Content="256 MB" Tag="256" />
                    <ComboBoxItem Content="512 MB（建議）" Tag="512" />
                    <ComboBoxItem Content="1024 MB" Tag="1024" />
                </ComboBox>
                <TextBlock x:Name="RamHint" Foreground="#777" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <DockPanel>
            <Button DockPanel.Dock="Left" Content="產生問題回報…" Padding="12,6" Click="OnReportClick"
                    ToolTip="把紀錄檔與電腦環境資訊打包成 zip 放到桌面，傳給開發者協助排除問題" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="確定" IsDefault="True" Padding="20,6" Margin="0,0,8,0" Click="OnOkClick" />
                <Button Content="取消" IsCancel="True" Padding="20,6" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
