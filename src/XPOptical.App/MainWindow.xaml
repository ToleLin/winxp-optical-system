<Window x:Class="XPOptical.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:XPOptical.App"
        Title="XP 光學系統"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="app.ico"
        Width="1120" Height="880" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop"
        Background="#15181D">
    <DockPanel>
        <!-- 工具列：只放少數按鈕 -->
        <Border DockPanel.Dock="Top" Background="{StaticResource ToolbarBackground}" Padding="8,6"
                BorderBrush="#D5DAE1" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="StartButton" Style="{StaticResource ToolButton}" Content="▶ 開啟 XP"
                            Click="OnStartClick" ToolTip="開啟 XP（若上次是休眠，會回到關閉前的畫面）" />
                    <Button x:Name="CtrlAltDelButton" Style="{StaticResource ToolButton}" Content="Ctrl+Alt+Del"
                            Click="OnCtrlAltDelClick" ToolTip="傳送 Ctrl+Alt+Del 到 XP（Windows 會攔截這組按鍵）" />
                    <Button x:Name="MediaButton" Style="{StaticResource ToolButton}" Content="放入檔案 ▼"
                            Click="OnMediaClick"
                            ToolTip="把安裝檔等檔案做成光碟放進 XP（也可以直接把資料夾拖進視窗）">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="匯入資料夾（做成光碟放進 XP）…" Click="OnInsertFolderClick" />
                                <MenuItem Header="放入光碟映像（ISO 檔）…" Click="OnInsertIsoClick" />
                                <Separator />
                                <MenuItem Header="退出光碟" Click="OnEjectClick" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ShutdownButton" Style="{StaticResource ToolButton}" Content="■ 關機"
                            Click="OnShutdownClick" ToolTip="讓 XP 正常關機" />
                    <Button x:Name="InstallDoneButton" Style="{StaticResource ToolButton}" Content="✔ XP 安裝完成"
                            Click="OnInstallDoneClick" Visibility="Collapsed"
                            ToolTip="XP 安裝完成、已看到 XP 桌面後按這裡" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}" Content="設定"
                            Click="OnSettingsClick" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 狀態列 -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource ToolbarBackground}" Padding="10,5"
                BorderBrush="#D5DAE1" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="VmStatusText" Text="XP：已關機" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="16" Fill="#C5CBD3" Margin="12,0" />
                    <Ellipse x:Name="UsbDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" />
                    <TextBlock x:Name="UsbStatusText" Margin="6,0,0,0" VerticalAlignment="Center" />
                    <Rectangle x:Name="AccelSeparator" Width="1" Height="16" Fill="#C5CBD3" Margin="12,0" />
                    <TextBlock x:Name="AccelText" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="FixButton" DockPanel.Dock="Right" Padding="10,2" Visibility="Collapsed"
                        Click="OnFixClick" />
            </DockPanel>
        </Border>

        <Grid>
            <local:VncDisplay x:Name="Display" Visibility="Collapsed" />

            <!-- 首次使用：建立 XP 環境 -->
            <ScrollViewer x:Name="SetupPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Style="{StaticResource Title}" Text="歡迎使用 XP 光學系統" />
                    <TextBlock Style="{StaticResource Hint}" FontSize="15" Margin="0,0,0,20"
                               Text="第一次使用，請先建立 XP 環境（只需要做一次）。" />

                    <Button x:Name="InstallButton" Style="{StaticResource BigButton}" Content="從 XP 安裝光碟安裝…"
                            Click="OnInstallClick" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                               Text="需要 Windows XP 安裝光碟的 ISO 檔與產品序號。XP 安裝畫面會出現在這個視窗裡，照著畫面操作即可；安裝完成後按工具列的「XP 安裝完成」。" />

                    <Button x:Name="ContinueInstallButton" Style="{StaticResource BigButton}"
                            Content="繼續先前未完成的安裝…" Click="OnContinueInstallClick" Visibility="Collapsed" />

                    <Button x:Name="ImportButton" Style="{StaticResource BigButton}" Content="使用現有的 XP 磁碟映像…"
                            Click="OnImportClick" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="已經有裝好的 XP 映像檔（.qcow2、.vhd、.vmdk、.img）時使用。" />

                    <ProgressBar x:Name="ImportProgress" Height="10" Margin="0,20,0,0" Maximum="100"
                                 Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- XP 已關機 -->
            <StackPanel x:Name="StoppedPanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StoppedTitle" Style="{StaticResource Title}" Text="XP 已關機" />
                <Button Style="{StaticResource BigButton}" Content="▶ 開啟 XP" Click="OnStartClick" />
                <TextBlock x:Name="StoppedHint" Style="{StaticResource Hint}" />
            </StackPanel>

            <!-- 找不到執行引擎 -->
            <StackPanel x:Name="MissingEnginePanel" Visibility="Collapsed" HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Title}" Text="找不到執行引擎" />
                <TextBlock Style="{StaticResource Hint}" FontSize="15"
                           Text="程式資料夾裡缺少 engine 資料夾。請確認是把整個 XPOptical 資料夾解壓縮後再執行，而不是只複製 XPOptical.exe。" />
            </StackPanel>

            <!-- 處理中（啟動、存檔、關機） -->
            <Border x:Name="BusyPanel" Visibility="Collapsed" Background="#CC15181D">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="BusyText" Style="{StaticResource Title}" Text="請稍候…" />
                    <ProgressBar IsIndeterminate="True" Width="320" Height="8" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
