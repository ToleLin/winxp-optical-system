<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 允許在 Linux（雲端/CI）上編譯 Windows 程式 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>XPOptical</AssemblyName>
    <RootNamespace>XPOptical.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 可獨立運行：自帶 .NET 執行環境的單一 exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XPOptical.Core\XPOptical.Core.csproj" />
  </ItemGroup>
</Project>
